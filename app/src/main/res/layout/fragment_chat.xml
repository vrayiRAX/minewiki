<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mc_background">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/mc_bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:contentDescription="Volver"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASISTENTE IA MINECRAFT"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Powered by Groq LPU &amp; RAG Wiki"
                android:textColor="@color/mc_green_face"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/mc_green_face"/>

    <!-- Chips de Preguntas Rápidas / Sugerencias -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="8dp"
        android:background="#191919">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipWarden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👁️ ¿Cómo vencer al Warden?"
                android:background="@color/mc_input_bg"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipBeacon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 ¿Cómo activar un Faro?"
                android:background="@color/mc_input_bg"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipNether"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Regla de viajes en Nether"
                android:background="@color/mc_input_bg"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- RecyclerView para el Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Barra de Entrada de Texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/mc_bg_card"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@color/mc_input_bg"
            android:hint="Haz una pregunta de Minecraft..."
            android:textColorHint="@color/mc_gray_text"
            android:textColor="@color/white"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:maxLines="3"
            android:layout_marginEnd="8dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSendChat"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_mc_3d"
            android:text="ENVIAR"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
